<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Stopwatch top knob -->
    <path
        android:fillColor="#818CF8"
        android:pathData="M51,26 h6 v4 h-6 z" />
    <path
        android:fillColor="#6366F1"
        android:pathData="M48,24 h12 v2 h-12 z" />

    <!-- Outer Circular Rim of Clock -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32 C67.25,32 78,42.75 78,56 C78,69.25 67.25,80 54,80 C40.75,80 30,69.25 30,56 C30,42.75 40.75,32 54,32 Z"
        android:strokeWidth="4"
        android:strokeColor="#38BDF8"
        android:strokeLineCap="round" />

    <!-- Circular Progress Arc (from 12 to 5 o'clock) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,32 A24,24 0 0,1 77.5,63"
        android:strokeWidth="5"
        android:strokeColor="#818CF8"
        android:strokeLineCap="round" />

    <!-- Center Pivot Dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,53 A3,3 0 1,0 54,59 A3,3 0 1,0 54,53 Z" />

    <!-- Clock Minute Hand (pointing to 12) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M52.5,41 h3 v13 h-3 z" />

    <!-- Clock Hour Hand (pointing to 3) -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M54,54.5 h11 v3 h-11 z" />

    <!-- Bold Checkmark accent in bottom-left -->
    <path
        android:fillColor="#00000000"
        android:pathData="M40,56 L47,63 L65,45"
        android:strokeWidth="4"
        android:strokeColor="#10B981"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
